# Copy this file to ".env" and replace the placeholder values below.
# The application loads ".env" (see django_scraper/settings.py).

# Set DEBUG to False for prod
DEBUG=True
# SECRET_KEY can (and should) be re-generated using get_random_secret_key() from django.core.management.utils
SECRET_KEY=replace-me-with-a-generated-secret-key
ALLOWED_HOSTS=localhost
# Seconds between search requests (plus random jitter below)
SCRAPE_REQUEST_DELAY_SECONDS=3.0
SCRAPE_REQUEST_DELAY_JITTER_SECONDS=1.0
SCRAPE_REQUEST_TIMEOUT_SECONDS=30
# Database connection. Unset = local SQLite (dev/test default). Set to a
# Postgres URL in production (requires the psycopg driver from requirements.txt).
# See docs/postgres_migration.md for the full migration path.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
