# Copy this file to ".env" and replace the placeholder values below.
# The application loads ".env" (see django_scraper/settings.py).

# Production: set DEBUG=False. Local dev may use True.
DEBUG=True
# Generate a fresh key per environment (never commit real secrets):
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Production must use a distinct key from dev/staging.
SECRET_KEY=replace-me-with-a-generated-secret-key
# Production: set to your public domain(s), e.g. tracker.example.com
ALLOWED_HOSTS=localhost
# Set True ONLY on the public HTTPS deployment: enables SSL redirect, secure
# cookies, and HSTS. Leave False for local dev and tests.
SECURE_DEPLOYMENT=False
# Comma-separated https origins for CSRF when SECURE_DEPLOYMENT=True, e.g.
# CSRF_TRUSTED_ORIGINS=https://tracker.example.com
# Seconds between search requests (plus random jitter below)
SCRAPE_REQUEST_DELAY_SECONDS=3.0
SCRAPE_REQUEST_DELAY_JITTER_SECONDS=1.0
SCRAPE_REQUEST_TIMEOUT_SECONDS=30
# Database connection. Unset = local SQLite (dev/test default). Set to a
# Postgres URL in production (requires the psycopg driver from requirements.txt).
# See docs/postgres_migration.md for the full migration path.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Redis for Huey (queued/scheduled scrapes). Unset or empty = not configured.
# Typical local value: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# Rate-limit awareness for API-profiled Sources (rate_limit_profile set to
# something other than blank/"none"). Only affects those sources — default
# Sources keep the fixed SCRAPE_REQUEST_DELAY_SECONDS pacing above. Shared
# pacing state lives in Redis (REDIS_URL above) in production; unset Redis
# falls back to an in-memory store (dev/tests only — not shared across
# workers). See tracking/ratelimit/ and openspec/changes/api-rate-limit-awareness/.
# RATE_LIMIT_HEADROOM_PCT=0.50
# RATE_LIMIT_MIN_INTERVAL_SECONDS=3.0
# RATE_LIMIT_FAIR_INTERVAL=True
# RATE_LIMIT_SHORT_WAIT_THRESHOLD_SECONDS=5.0
# RATE_LIMIT_MAX_REQUESTS_PER_RUN=10000
# RATE_LIMIT_MAX_COST_PER_RUN=100000
# RATE_LIMIT_MAX_DEFER_ATTEMPTS=5
# RATE_LIMIT_MAX_RUN_WALL_CLOCK_SECONDS=1800
